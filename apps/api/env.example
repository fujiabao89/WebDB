# WebDB API 服务配置示例
# 复制为 .env 并填入实际值；.env 不会被提交

# 元数据库连接
META_DB_HOST=webdb-meta
META_DB_PORT=5432
META_DB_USER=webdb
META_DB_PASSWORD=change_me_in_production
META_DB_NAME=webdb_meta
# 元数据库连接池（Owner 批准 2026-08：缺失/非法/idle>open 时 API 拒绝启动，fail-closed）
META_DB_MAX_OPEN_CONNS=10
META_DB_MAX_IDLE_CONNS=2
META_DB_CONN_MAX_LIFETIME=30m

# 密钥加密根密钥 (KEK) — 版本化格式 WEBDB_KEK_V{N}（RFC 4648 base64，32 字节）
# + WEBDB_ACTIVE_KEK_VERSION（正整数，显式指定当前写入版本）。
# 必填：下方占位值非法（非 32 字节 base64），缺失/非法时相关组件 fail-closed。
# 生成方式：openssl rand -base64 32（输出 44 字符 base64，解码为 32 字节），粘贴到下方。
# 演示 seed 使用同组变量（deploy/compose/env.example 提供合成 demo 值）。
WEBDB_KEK_V1=REPLACE_ME__openssl_rand_-base64_32
WEBDB_ACTIVE_KEK_VERSION=1

# 服务端口
API_PORT=8080

# 演示数据库（P0 合成数据，仅限本地；变量名与 seed 实际读取一致）
# PostgreSQL 只读账号名固定为 demo_reader（seed 权威常量，非环境可配，无 DEMO_PG_USER 变量）；
# 密码由 seed 读取 DEMO_PG_READER_PASSWORD（见 internal/seeddemo/config.go）。
DEMO_PG_HOST=demo-pg
DEMO_PG_PORT=5432
DEMO_PG_READER_PASSWORD=change_me_in_production
DEMO_PG_NAME=webdb_demo

# MySQL 只读账号名由 seed 读取 DEMO_MYSQL_USER（校验必须为 demo_reader，不可改为 root）；
# 密码由 seed 读取 DEMO_MYSQL_READER_PASSWORD。
DEMO_MYSQL_HOST=demo-mysql
DEMO_MYSQL_PORT=3306
DEMO_MYSQL_USER=demo_reader
DEMO_MYSQL_READER_PASSWORD=change_me_in_production
DEMO_MYSQL_NAME=webdb_demo
