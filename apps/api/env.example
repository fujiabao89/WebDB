# WebDB API 服务配置示例
# 复制为 .env 并填入实际值；.env 不会被提交

# 元数据库连接
META_DB_HOST=webdb-meta
META_DB_PORT=5432
META_DB_USER=webdb
META_DB_PASSWORD=change_me_in_production
META_DB_NAME=webdb_meta

# 密钥加密根密钥 (KEK)
# 至少 32 字节的 base64 编码值；生产环境必须替换
WEBDB_KEK=change_me_in_production

# 服务端口
API_PORT=8080

# 演示数据库（P0 合成数据，仅限本地）
DEMO_PG_HOST=demo-pg
DEMO_PG_PORT=5432
DEMO_PG_USER=demo_reader
DEMO_PG_PASSWORD=change_me_in_production
DEMO_PG_NAME=webdb_demo

DEMO_MYSQL_HOST=demo-mysql
DEMO_MYSQL_PORT=3306
DEMO_MYSQL_USER=demo_reader
DEMO_MYSQL_PASSWORD=change_me_in_production
DEMO_MYSQL_NAME=webdb_demo
