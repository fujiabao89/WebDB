# WebDB API 服务配置示例
# 复制为 .env 并填入实际值；.env 不会被提交

# 元数据库连接
META_DB_HOST=webdb-meta
META_DB_PORT=5432
META_DB_USER=webdb
META_DB_PASSWORD=change_me_in_production
META_DB_NAME=webdb_meta
# 元数据库连接池（Owner 批准 2026-08：缺失/非法/idle>open 时 API 拒绝启动，fail-closed）
META_DB_MAX_OPEN_CONNS=10
META_DB_MAX_IDLE_CONNS=2
META_DB_CONN_MAX_LIFETIME=30m

# 密钥加密根密钥 (KEK) — 版本化格式 WEBDB_KEK_V{N}（RFC 4648 base64，32 字节）
# + WEBDB_ACTIVE_KEK_VERSION（正整数，显式指定当前写入版本）。
# 缺失/弱值/版本不匹配时相关组件 fail-closed；生产必须替换为真实随机值。
# 演示 seed 使用同组变量（deploy/compose/env.example 提供合成 demo 值）。
WEBDB_KEK_V1=change_me_in_production_32bytes_base64
WEBDB_ACTIVE_KEK_VERSION=1

# 服务端口
API_PORT=8080

# 演示数据库（P0 合成数据，仅限本地）
DEMO_PG_HOST=demo-pg
DEMO_PG_PORT=5432
DEMO_PG_USER=demo_reader
DEMO_PG_PASSWORD=change_me_in_production
DEMO_PG_NAME=webdb_demo

DEMO_MYSQL_HOST=demo-mysql
DEMO_MYSQL_PORT=3306
DEMO_MYSQL_USER=demo_reader
DEMO_MYSQL_PASSWORD=change_me_in_production
DEMO_MYSQL_NAME=webdb_demo
