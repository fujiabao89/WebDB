# WebDB Compose 环境变量模板
# 复制为 .env 并填入实际值；.env 不会被提交
# 以下所有值均为占位符，仅适用于本地开发

# 元数据库
META_DB_PASSWORD=change_me

# 演示 PostgreSQL
DEMO_PG_USER=demo_admin
DEMO_PG_PASSWORD=change_me

# 演示 MySQL
DEMO_MYSQL_ROOT_PASSWORD=change_me
DEMO_MYSQL_USER=demo_reader
DEMO_MYSQL_PASSWORD=change_me

# 密钥加密根密钥 — 至少 32 字节 base64
WEBDB_KEK=change_me
