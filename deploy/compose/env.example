# WebDB Compose 环境变量模板
# 复制为 .env 并填入实际值；.env 不会被提交
# 以下值中：数据库密码占位符（change_me）仅适用于本地演示；
# WEBDB_KEK_V1 必须按下方说明生成并替换（占位值非法，缺失/非法即拒绝启动）。

# 元数据库
META_DB_PASSWORD=change_me
# 元数据库连接池（Owner 批准 2026-08：API 缺失/非法/idle>open 时拒绝启动）
META_DB_MAX_OPEN_CONNS=10
META_DB_MAX_IDLE_CONNS=2
META_DB_CONN_MAX_LIFETIME=30m

# 演示 PostgreSQL
DEMO_PG_USER=demo_admin
DEMO_PG_PASSWORD=change_me
DEMO_PG_READER_PASSWORD=change_me

# 演示 MySQL
DEMO_MYSQL_ROOT_PASSWORD=change_me
DEMO_MYSQL_USER=demo_reader
DEMO_MYSQL_READER_PASSWORD=change_me

# 演示身份（固定合成 UUID，必须与 seed 权威来源一致；勿修改）
# 由 demo-seed 校验与权威值一致，不一致即拒绝启动。
DEMO_PRINCIPAL_WORKSPACE_ID=f1160d75-26f7-46e0-b3e0-570ea65c232e
DEMO_PRINCIPAL_USER_ID=73e8c8f0-83e4-4096-8400-15ca15073d6b

# 密钥加密根密钥（KEK）— 版本化格式 WEBDB_KEK_V{N} + WEBDB_ACTIVE_KEK_VERSION
# 必填：下方占位值非法（非 32 字节 base64），API 严格校验并 fail-closed，缺失/非法时 api/web 不启动。
# 生成方式（输出 44 字符 base64，解码为 32 字节）：
#   openssl rand -base64 32
# 将输出整行粘贴到 WEBDB_KEK_V1= 后。不得把真实 KEK 提交进仓库；生产由部署环境注入（ADR-006）。
WEBDB_KEK_V1=REPLACE_ME__openssl_rand_-base64_32
WEBDB_ACTIVE_KEK_VERSION=1
